{
  "name": "cloud-swe",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter server dev",
    "test": "node scripts/test.mjs",
    "test:inside": "node --experimental-strip-types --test tools/oxlint/cloud-swe/*.test.ts && pnpm --filter @cloud-swe/protocol test && pnpm typecheck && pnpm --filter server build:test && pnpm --filter server test",
    "typecheck": "pnpm -r typecheck && tsc -p tools",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "knip": "knip",
    "leaks": "gitleaks git --redact --no-banner --log-level warn",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "knip": "^6.44.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,yml,yaml}": "oxfmt"
  },
  "packageManager": "pnpm@11.22.0"
}
