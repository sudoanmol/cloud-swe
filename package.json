{
  "name": "cloud-swe",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter server dev",
    "test": "node scripts/test.mjs",
    "test:inside": "pnpm --filter @cloud-swe/protocol test && pnpm typecheck && pnpm --filter server build:test && pnpm --filter server test",
    "typecheck": "pnpm -r typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,md,yml,yaml}": "oxfmt"
  },
  "packageManager": "pnpm@11.22.0"
}
