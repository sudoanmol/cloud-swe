{
  "name": "@cloud-swe/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose -f ../../compose.yml up -d --wait postgres",
    "db:watch": "docker compose -f ../../compose.yml up postgres",
    "db:stop": "docker compose -f ../../compose.yml stop postgres",
    "db:down": "docker compose -f ../../compose.yml rm --stop --force postgres"
  },
  "dependencies": {
    "@cloud-swe/env": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloud-swe/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
