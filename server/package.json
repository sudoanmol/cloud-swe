{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc -c wrangler.codemode.jsonc --env-file ../.env",
    "typecheck": "tsc --noEmit",
    "build:test": "wrangler deploy -c wrangler.codemode.jsonc --dry-run --outdir dist/codemode && wrangler deploy --dry-run --outdir dist",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "deploy": "wrangler deploy -c wrangler.codemode.jsonc --minify && wrangler deploy --minify",
    "e2b:template": "node --experimental-strip-types --env-file=../.env scripts/e2b-template.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@cloud-swe/protocol": "workspace:*",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "agents": "0.32.0",
    "better-auth": "^1.7.14",
    "e2b": "2.62.0",
    "effect": "4.1.0",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "miniflare": "5.20261023.2-beta",
    "wrangler": "^4.110.0"
  }
}
