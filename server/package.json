{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build:test": "wrangler deploy --dry-run --outdir dist",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@boatdev/sdk": "^1.13.0",
    "@cloud-swe/protocol": "workspace:*",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "agents": "0.32.0",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "miniflare": "5.20261023.2-beta",
    "wrangler": "^4.110.0"
  }
}