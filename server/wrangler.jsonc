{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-swe-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      {
        "name": "CODEMODE",
        "class_name": "CodemodeSandbox",
        "script_name": "cloud-swe-codemode",
      },
      {
        "name": "CATALOG",
        "class_name": "CatalogV2",
      },
      {
        "name": "THREADS",
        "class_name": "SessionThreadV2",
      },
      {
        "name": "CREDENTIALS",
        "class_name": "Credentials",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionCatalog", "Thread"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Credentials"],
    },
    // Started clean after the move to E2B; the old classes held sessions from before it.
    {
      "tag": "v3",
      "new_sqlite_classes": ["Catalog", "SessionThread"],
    },
    {
      "tag": "v4",
      "deleted_classes": ["SessionCatalog", "Thread"],
    },
    // Wiped for the 2026-11-03 template rename: stored creations embed the old request shape. Credentials is kept.
    // Cloudflare won't delete a class the deployed version still binds, so the old classes went in the next deploy.
    {
      "tag": "v5",
      "new_sqlite_classes": ["CatalogV2", "SessionThreadV2"],
    },
    {
      "tag": "v6",
      "deleted_classes": ["Catalog", "SessionThread"],
    },
  ],
  // A pull request deploys to this second, separate Worker: its own Durable Objects, migrations, secrets and URL.
  "env": {
    "preview": {
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CatalogV2", "SessionThreadV2", "Credentials"] }],
      "durable_objects": {
        "bindings": [
          { "name": "CODEMODE", "class_name": "CodemodeSandbox", "script_name": "cloud-swe-codemode-preview" },
          { "name": "CATALOG", "class_name": "CatalogV2" },
          { "name": "THREADS", "class_name": "SessionThreadV2" },
          { "name": "CREDENTIALS", "class_name": "Credentials" },
        ],
      },
    },
  },
}
