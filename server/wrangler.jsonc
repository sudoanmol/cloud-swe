{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-swe-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      {
        "name": "CODEMODE",
        "class_name": "CodemodeSandbox",
        "script_name": "cloud-swe-codemode",
      },
      {
        "name": "CATALOG",
        "class_name": "SessionCatalog",
      },
      {
        "name": "THREADS",
        "class_name": "Thread",
      },
      {
        "name": "CREDENTIALS",
        "class_name": "Credentials",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionCatalog", "Thread"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Credentials"],
    },
    // Wipes every session once, in one deploy, after the move to E2B: their stored shape and Boat sandboxes are gone.
    {
      "tag": "v3",
      "deleted_classes": ["SessionCatalog", "Thread"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["SessionCatalog", "Thread"],
    },
  ],
}
