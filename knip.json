{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/oxlint/anti-slop/**", "experiments/**"],
  "ignoreBinaries": ["gitleaks"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tools/oxlint/cloud-swe/*.test.ts", "ios/scripts/*.ts"]
    },
    "protocol": {
      "entry": ["test/*.test.ts"]
    },
    "server": {
      "entry": ["test/*.test.ts", "src/codemode.ts", "scripts/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
