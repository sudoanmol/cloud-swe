{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/oxlint/anti-slop/**"],
  "ignoreBinaries": ["pbpaste", "gitleaks"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "protocol": {
      "entry": ["test/*.test.ts"]
    },
    "server": {
      "entry": ["test/*.test.ts", "src/codemode.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
