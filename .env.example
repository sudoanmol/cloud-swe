# Local dev bindings for the Worker. Copy to .env; `pnpm dev` loads it via `wrangler dev --env-file ../.env`.
# Production uses `wrangler secret put` instead. Tests inject their own values and ignore this file.

# Signs sign-in sessions. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The only GitHub account allowed in, by numeric ID: gh api users/<login> --jq .id
GITHUB_ALLOWED_USER_ID=

# From the GitHub App's settings page. Sign-in uses the client ID and secret; installation tokens use the client ID and key.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PKCS#8 PEM, quoted across lines. Convert the downloaded key: openssl pkcs8 -topk8 -nocrypt -in app.pem -out app-pkcs8.pem
GITHUB_APP_PRIVATE_KEY=

# Always `e2b`. `docker` is the test double that only runs inside `pnpm test`.
WORKSPACE_BACKEND=e2b

# Comma-separated E2B template names sessions may request. Build `cloud-swe` once per E2B
# account with `pnpm --filter server e2b:template`. E2B's own `base` also works, but has only 2 vCPU and 512 MB.
# Allowlisted templates must not pass Git or model credentials into sandboxes.
WORKSPACE_TEMPLATES=cloud-swe

# The only model selector sessions may request. Keys are normally set through the client API.
MODEL_PROVIDER=anthropic
MODEL_ID=claude-sonnet-5-5

# Optional development/test fallback; client keys override it and DELETE disables it. Never commit it.
ANTHROPIC_API_KEY=

# Optional. Enables the web_search and web_fetch tools (Firecrawl). Stays in the Worker; never enters a sandbox.
FIRECRAWL_API_KEY=

# Public https base URL of this Worker, no trailing slash. GitHub returns to PUBLIC_URL/v1/auth/callback/github after
# sign-in, and sandboxes reach the Git proxy at PUBLIC_URL/git/... http://localhost:8787 is enough to test sign-in alone.
# Git tools need a URL that reaches the Worker holding the session: a deployed URL, or a tunnel for `pnpm dev`.
PUBLIC_URL=

# E2B account key. The server creates one sandbox per session. Never commit it.
E2B_API_KEY=

# Docker mode only: the provisioning test double, reachable from the Worker.
DOCKER_SANDBOX_URL=
DOCKER_SANDBOX_TOKEN=

# Optional lifecycle numbers (defaults shown).
# Running sandboxes allowed at once; the only product limit.
# MAX_SANDBOXES=4
# A sandbox is deleted after this many days without activity.
# SANDBOX_DELETE_AFTER_DAYS=7
# How often an active run renews the sandbox's auto-stop deadline.
# KEEPALIVE_INTERVAL_SECONDS=120

# Not read by the Worker: your bearer token for calling this API, shown at PUBLIC_URL/v1/auth/token after signing in at
# PUBLIC_URL/v1/auth/login. Lasts 30 days and renews with use. Never commit it.
CLOUD_SWE_TOKEN=
