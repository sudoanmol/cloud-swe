# Local dev bindings for the Worker. Copy to .env; `pnpm dev` loads it via `wrangler dev --env-file ../.env`.
# Production uses `wrangler secret put` instead. Tests inject their own values and ignore this file.

# Personal API bearer token for every request. Generate: openssl rand -hex 32
API_TOKEN=

# `boat` or `docker`. The Docker sandbox only runs inside `pnpm test`, so use `boat` for dev.
WORKSPACE_BACKEND=boat

# Comma-separated Boat environment names sessions may request. Every account has `base`.
# Allowlisted environments must not pass Git or model credentials into sandboxes.
WORKSPACE_ENVIRONMENTS=base

# The only model selector sessions may request. Keys are normally set through the client API.
MODEL_PROVIDER=anthropic
MODEL_ID=claude-sonnet-5-5

# Optional development/test fallback; client keys override it and DELETE disables it. Never commit it.
ANTHROPIC_API_KEY=

# Boat account key. The server creates one sandbox per session. Never commit it.
BOAT_API_KEY=

# Docker mode only: the provisioning test double, reachable from the Worker.
DOCKER_SANDBOX_URL=
DOCKER_SANDBOX_TOKEN=
