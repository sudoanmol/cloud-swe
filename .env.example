DATABASE_URL=postgresql://postgres:password@localhost:5432/cloud-swe
BETTER_AUTH_SECRET=local-development-only-change-this-secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
# Fastify API origin for the web app, used by the browser and the SSR session gate.
VITE_API_URL=http://localhost:3000
# GitHub App Client ID and Client secret (not a legacy OAuth App).
# Callback URL: http://localhost:3000/api/auth/callback/github
# Account permission required: Email addresses, Read-only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App slug used to build the install URL and to accept only this App's
# installations during onboarding readiness checks.
GITHUB_APP_SLUG=
# Comma-separated numeric GitHub account IDs allowed to run tasks.
# Find an ID at https://api.github.com/users/<login>.
ALLOWED_GITHUB_ACCOUNT_IDS=
ALLOW_UNVERIFIED_COMPUTE=true
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
MAX_ACTIVE_RUNS=5
SSE_POLL_MS=200
SSE_HEARTBEAT_MS=15000
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cloud-swe-runner
RUNNER_EXECUTION_MODE=scripted
RUNNER_SANDBOX_PROVIDER=docker
RUNNER_IDLE_PAUSE_MS=600000
RUNNER_MAX_RUN_MS=3600000
RUNNER_WORKSPACE_PREPARATION_TIMEOUT_MS=420000
RUNNER_PROVIDER_TIMEOUT_MS=30000
RUNNER_COMMAND_RECONCILE_TIMEOUT_MS=30000
RUNNER_COMMAND_OUTPUT_MAX_BYTES=262144
RUNNER_CHECKPOINT_MAX_BYTES=4194304
RUNNER_ACTIVITY_RETRY_MAX_ATTEMPTS=3
RUNNER_ACTIVITY_RETRY_WINDOW_MS=1900000
RUNNER_STEP_DELAY_MS=500
RUNNER_ACTIVITY_CONCURRENCY=10
RUNNER_REPOSITORY_CLONE_TIMEOUT_MS=240000
RUNNER_REPOSITORY_MAX_BYTES=4294967296
RUNNER_REPOSITORY_MIN_FREE_BYTES=2147483648
RUNNER_DOCKER_IMAGE=ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517
# Modal sandbox provider. Copy the token from `modal token new` (~/.modal.toml).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=main
MODAL_APP_NAME=cloud-swe-workspaces
# Published by `uv run infra/modal/build_image.py`.
MODAL_IMAGE_NAME=cloud-swe-workspace
MODAL_SANDBOX_LIMIT=5
MODAL_MAX_RUN_SECONDS=5400
# Paid Modal/Pi integration is opt-in and also needs DEEPSEEK_API_KEY; do not add this to .env by default:
# RUN_PAID_INTEGRATION_TESTS=1 bun run test:backend:paid
# Shared server/runner key: generate with openssl rand -hex 32. Keep outside Git.
MODEL_CREDENTIALS_ENCRYPTION_KEY=
# Private Cloudflare R2 bucket shared by the API server and runner. Region defaults to auto.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
# Optional per-user Composio MCP. Set on API server and runner only.
# Unset disables MCP. Connect toolkits in onboarding or Settings.
# Never expose this key or session headers to the sandbox.
COMPOSIO_API_KEY=
LOG_LEVEL=info

# GitHub broker: configure all three to enable private Git and approvals.
# URL must be reachable from both runner and sandbox, using HTTPS outside local tests.
GIT_BROKER_URL=
GIT_BROKER_SECRET=
GIT_BROKER_STORAGE=
GIT_BROKER_MAX_BYTES=4294967296
GIT_BROKER_MIN_FREE_BYTES=2147483648

# Previews: `{port}-{slug}.<PREVIEW_DOMAIN>` through apps/gateway. Point the
# wildcard `*.<PREVIEW_DOMAIN>` at the gateway (DNS-only on Cloudflare). Unset
# disables previews.
PREVIEW_DOMAIN=
GATEWAY_PORT=3002
GATEWAY_HOST=0.0.0.0

# Hosted browser: all three together, on server, runner, and gateway. Leave all
# unset to disable. Relay URL is the gateway's public wss:// hostname plus /cdp.
KERNEL_API_KEY=
BROWSER_RELAY_URL=
BROWSER_RELAY_SECRET=

# Server-only DeepSeek title generation. Application-owned credential, separate
# from user chat providers and never surfaced in the chat model selector.
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
